// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum link_status {
  active
  expired
  disabled
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  emailVerified Boolean @default(false)
  createdAt DateTime
  links Link[]
  account Account?
}

model Link {
  id Int @id @default(autoincrement())
  userId Int?
  originalUrl String
  shortUrl String @unique
  createdAt DateTime @default(now())
  expireAt DateTime?
  status link_status @default(active)
  user User? @relation(fields: [userId], references: [id])
}

model Account {
  id Int @id @default(autoincrement())
  userId Int @unique
  provider String
  providerAccount String?
  passwordHash String?
  refreshToken String?
  accessToken String?
  expireAt DateTime?
  user User @relation(fields: [userId], references: [id])
}